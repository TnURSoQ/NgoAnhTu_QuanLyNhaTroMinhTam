# Tham khảo để đặt biến môi trường; Django không tự đọc tệp này.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Khi triển khai, đặt một khóa bí mật riêng và DJANGO_DEBUG=0.
# DJANGO_SECRET_KEY=your-generated-secret
# Bỏ DATABASE_URL để tiếp tục dùng db.sqlite3 hiện tại.
# DATABASE_URL=postgresql://username:password@localhost:5432/nhatro?sslmode=prefer
