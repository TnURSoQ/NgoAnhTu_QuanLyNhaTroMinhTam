# Sao chép thành .env; ứng dụng tự đọc tệp, ưu tiên biến môi trường đã có.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Khi triển khai, đặt một khóa bí mật riêng và DJANGO_DEBUG=0.
# DJANGO_SECRET_KEY=your-generated-secret
# Bỏ DATABASE_URL để tiếp tục dùng db.sqlite3 hiện tại.
# DATABASE_URL=postgresql://username:password@localhost:5432/nhatro?sslmode=prefer

# Mặc định chỉ xem thử thư trong terminal, chưa gửi thư thật.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PUBLIC_SITE_URL=http://127.0.0.1:8000

# Để gửi thật qua Gmail, thay EMAIL_BACKEND bên trên và bỏ dấu # các dòng sau.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=dia-chi-gui@gmail.com
# EMAIL_HOST_PASSWORD="mat-khau-ung-dung"
# DEFAULT_FROM_EMAIL="Nhà trọ Minh Tâm <dia-chi-gui@gmail.com>"
# EMAIL_REPLY_TO=dia-chi-gui@gmail.com
# EMAIL_TIMEOUT=10
# SITE_PHONE=so-dien-thoai-chu-tro
# SITE_ADDRESS="Địa chỉ cụ thể của nhà trọ"
# Khi triển khai, PUBLIC_SITE_URL phải là địa chỉ khách truy cập được.
